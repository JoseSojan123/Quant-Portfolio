# Copy to .env and edit. Never commit the real .env; it is in .gitignore.
# Every value below has a working default except JWT_SECRET in production.

# ---------------------------------------------------------------- application
APP_ENV=development                 # development | production | test
APP_VERSION=1.0.0

# ---------------------------------------------------------------- database
# Leave unset for SQLite: the database file is created at backend/data/app.db.
# DATABASE_URL=sqlite:////absolute/path/to/app.db
# PostgreSQL / Supabase (a postgres:// prefix is rewritten to postgresql://):
# DATABASE_URL=postgresql://quant:password@localhost:5432/quant
# DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# ---------------------------------------------------------------- sessions
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# In development a secret is generated once and kept in backend/data/.jwt_secret.
JWT_SECRET=
ACCESS_TOKEN_DAYS=7
REMEMBER_ME_DAYS=30
COOKIE_NAME=qp_session
# Defaults to true in production. Set false only when serving plain HTTP locally.
# COOKIE_SECURE=
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------- urls / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Read by the Next.js server when proxying /api/* to the backend.
API_URL=http://localhost:8000

# ---------------------------------------------------------------- email
# With no SMTP host, verification and reset emails are logged instead of sent.
REQUIRE_EMAIL_VERIFICATION=true
# Returns verification/reset links in API responses. Development only; forced off in production.
# EXPOSE_DEV_LINKS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Quant Portfolio Platform <no-reply@example.com>

# ---------------------------------------------------------------- market data
# synthetic = deterministic offline generator (no network needed)
# yahoo     = live adjusted closes via yfinance
DATA_SOURCE=synthetic
AUTO_SEED=true
GITHUB_URL=https://github.com/your-username/quant-portfolio-platform

# ---------------------------------------------------------------- limits
HEAVY_RATE_LIMIT_PER_MINUTE=40
AUTH_RATE_LIMIT_PER_MINUTE=20
MAX_MC_SIMULATIONS=20000
MAX_MC_HORIZON_DAYS=2520
MAX_MC_CELLS=6000000
GUEST_TTL_HOURS=48
